<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (this file is in src/debug): the build for the emulator.
     The release build that goes on a business's tablets has none of this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- usesCleartextTraffic: a debug build may talk to the ordering site's relay
         running on this PC (relayUrl=http://10.0.2.2:8787), which has no https. -->
    <application android:usesCleartextTraffic="true">
        <!-- Fills a tablet that was never set up with a made-up shop, so the
             shop's screens can be used with no login and no server:
               adb shell am broadcast -n com.restopos.app/com.restopos.debug.DemoReceiver -a com.restopos.app.DEMO_SHOP
             It refuses a tablet that is set up for a business.
             With the boolean extra "setup" true, the made-up business's
             first-run set-up is open, as for a client just made in /admin
             (the command is in DemoReceiver, where the business is seeded).
             With the type "restaurant" and "ordering" true, the made-up restaurant
             takes orders from its tables through the relay running on this PC
             (cloudflare/relay/README.md, "With the till on an emulator").
             DEMO_SCAN stands in for a barcode scanner, which an emulator has
             none of: the code goes to the screen that is open, as a scan would.
             The command, with its code, is at the top of DemoReceiver.onReceive. -->
        <receiver android:name="com.restopos.debug.DemoReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.restopos.app.DEMO_SHOP" />
                <action android:name="com.restopos.app.DEMO_PULL" />
                <action android:name="com.restopos.app.DEMO_SCAN" />
                <action android:name="com.restopos.app.DEMO_STOCK" />
                <action android:name="com.restopos.app.DEMO_PRINTER" />
                <action android:name="com.restopos.app.DEMO_CHIME" />
                <action android:name="com.restopos.app.DEMO_UPDATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
