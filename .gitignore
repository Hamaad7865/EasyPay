# Fresh-start greenfield (Neon). History kept in git; old tree stays deleted.
.neon
node_modules/

# env files (the template carries no secrets and stays committed)
.env*
!.env.example

# the till's signing key: this repository is public, and the key is kept outside it
*.jks
*.keystore

# web (Next.js back office)
web/.next/
web/out/
web/build/

# cloudflare: the back office built for Workers, wrangler's local state, local settings
web/.open-next/
.wrangler/
.dev.vars

# android
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
android/local.properties
*.hprof

# general
.DS_Store
*.pem
npm-debug.log*
coverage/
*.tsbuildinfo

# opencode's local config — credentials, not source.
.opencode/
