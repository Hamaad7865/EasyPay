# Copy to .env.local (root) via `neon link` / `neon env pull` — never commit secrets.
# Pooled app URL (local dev + web). Unpooled URL for migrations (db/* scripts).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_FUNCTION_API_BASE_URL=
# App secret for Auth session cookies (generate: openssl rand -base64 32).
NEON_AUTH_COOKIE_SECRET=
# Public Function URL for browser calls (web).
NEXT_PUBLIC_FUNCTION_URL=
